			<key>Text</key>
			<string>#!/bin/bash

# Root folder is fixed – you set this once here
DUMMY_ROOT="/Users/tsukadjed/Library/CloudStorage/Dropbox/Automation/applications/Dummy Applications/Dummy Applications SDprofiles"

# Keyboard Maestro passes the parameter in %TriggerValue%, which we put into
# Local__sdeck_dummyAppName, so it appears here as KMVAR_Local__sdeck_dummyAppName
DUMMY_APP_NAME="$KMVAR_sdeck_dummyAppName"

APP_PATH="$DUMMY_ROOT/$DUMMY_APP_NAME.app"

if [ -d "$APP_PATH" ]; then
    open -a "$APP_PATH"
    exit 0
else
    echo "ERROR: app not found at $APP_PATH" &gt;&amp;2
    exit 1
fi
</string>
