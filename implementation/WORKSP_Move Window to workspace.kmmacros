			<string>#!/bin/zsh

A=/opt/homebrew/bin/aerospace
DEST_WS="${KMVAR_WORKSP_destWorkspace:-}"
WIN_ID="${KMVAR_WORKSP_windowID:-}"
BUTTON="${KMVAR_WORKSP_moveMode:-}"

trim() {
  local s="$1"
  s="${${s##[[:space:]]#}%%[[:space:]]#}"
  print -r -- "$s"
}

DEST_WS="$(trim "$DEST_WS")"
BUTTON="$(trim "$BUTTON")"

[[ -z "$DEST_WS" || -z "$WIN_ID" || -z "$BUTTON" ]] &amp;&amp; {
  echo "Missing variable(s)"
  echo "BUTTON=&lt;$BUTTON&gt;"
  echo "DEST_WS=&lt;$DEST_WS&gt;"
  echo "WIN_ID=&lt;$WIN_ID&gt;"
  exit 1
}

if [[ "$BUTTON" == "Follow" ]]; then
  exec "$A" move-node-to-workspace --focus-follows-window --window-id "$WIN_ID" -- "$DEST_WS"
elif [[ "$BUTTON" == "Stay" ]]; then
  exec "$A" move-node-to-workspace --window-id "$WIN_ID" -- "$DEST_WS"
else
  echo "Unknown button: &lt;$BUTTON&gt;"
  exit 1
fi
</string>
