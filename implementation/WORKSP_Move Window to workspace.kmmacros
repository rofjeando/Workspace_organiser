			<string>#!/bin/zsh

A=/opt/homebrew/bin/aerospace
DEST_WS="${1:-}"

if [[ -z "$DEST_WS" ]]; then
  echo "Usage: $0 &lt;destination-workspace&gt;" &gt;&amp;2
  exit 1
fi

WIN_ID="$($A list-windows --focused --format '%{window-id}' 2&gt;/dev/null)"
SRC_WS="$($A list-workspaces --focused --format '%{workspace}' 2&gt;/dev/null)"

if [[ -z "$WIN_ID" || -z "$SRC_WS" ]]; then
  osascript -e 'display dialog "AeroSpace did not report a focused window/workspace." buttons {"OK"} default button "OK"'
  exit 1
fi

CHOICE=$(osascript &lt;&lt;APPLESCRIPT
set theChoice to choose from list {"Move and follow", "Move and stay"} with title "AeroSpace move" with prompt "Move window " &amp; "$WIN_ID" &amp; " from workspace " &amp; "$SRC_WS" &amp; " to workspace " &amp; "$DEST_WS" &amp; "?" default items {"Move and stay"}
if theChoice is false then return ""
return item 1 of theChoice
APPLESCRIPT
)

if [[ -z "$CHOICE" ]]; then
  exit 0
fi

echo "Window ID: $WIN_ID"
echo "Source workspace: $SRC_WS"
echo "Destination workspace: $DEST_WS"
echo "Choice: $CHOICE"

if [[ "$CHOICE" == "Move and follow" ]]; then
  "$A" move-node-to-workspace --window-id "$WIN_ID" --focus-follows-window "$DEST_WS"
else
  "$A" move-node-to-workspace --window-id "$WIN_ID" "$DEST_WS"
  "$A" workspace "$SRC_WS"
fi
</string>
