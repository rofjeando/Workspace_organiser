			<string>#!/bin/zsh

A=/opt/homebrew/bin/aerospace
DEST_WS="${KMVAR_WORKSP_destWorkspace:-}"

[[ -z "$DEST_WS" ]] &amp;&amp; exit 1

WIN_ID="$($A list-windows --focused --format '%{window-id}' 2&gt;/dev/null)"
SRC_WS="$($A list-workspaces --focused --format '%{workspace}' 2&gt;/dev/null)"
APP_NAME="$($A list-windows --focused --format '%{app-name}' 2&gt;/dev/null)"
WIN_TITLE="$($A list-windows --focused --format '%{window-title}' 2&gt;/dev/null)"

[[ -z "$WIN_ID" || -z "$SRC_WS" ]] &amp;&amp; exit 1

SHORT_TITLE="$WIN_TITLE"
SHORT_TITLE="${SHORT_TITLE//$'\n'/ }"
SHORT_TITLE="${SHORT_TITLE//$'\r'/ }"

if [[ -z "$SHORT_TITLE" ]]; then
  SHORT_TITLE="$APP_NAME"
fi

MAXLEN=42
if (( ${#SHORT_TITLE} &gt; MAXLEN )); then
  SHORT_TITLE="${SHORT_TITLE[1,39]}..."
fi

/usr/bin/osascript &lt;&lt;APPLESCRIPT
tell application "Keyboard Maestro Engine"
  setvariable "WORKSP_windowID" to "$WIN_ID"
  setvariable "WORKSP_sourceWorkspace" to "$SRC_WS"
  setvariable "WORKSP_windowTitle" to "$APP_NAME | $SHORT_TITLE"
end tell
APPLESCRIPT

</string>
