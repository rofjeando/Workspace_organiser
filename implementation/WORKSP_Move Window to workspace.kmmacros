			<string>A=/opt/homebrew/bin/aerospace

WIN_ID="$($A list-windows --focused --format '%{window-id}' 2&gt;/dev/null)"
SRC_WS="$($A list-workspaces --focused --format '%{workspace}' 2&gt;/dev/null)"
DEST_WS="N"

echo "moving window $WIN_ID from $SRC_WS to $DEST_WS"
"$A" move-node-to-workspace --window-id "$WIN_ID" "$DEST_WS"
echo "done"
e"
